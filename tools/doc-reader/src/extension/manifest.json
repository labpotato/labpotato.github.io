{
  "manifest_version": 3,
  "name": "Lab Potato Doc Reader",
  "version": "3.1",
  "description": "Highlight and comment on any web page right where it is, and open it in Doc Reader to edit a copy with Word-style tools and an AI editor. Sign in with Google and your highlights and documents follow you to every computer.",
  "action": {
    "default_title": "Lab Potato: show or fold the tools on this page"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "downloads",
    "identity",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "library.html",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Show or fold the Lab Potato tools on this page"
    }
  },
  "key": ""
}
